# 서버
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/blog-automation

# Claude API (원고 생성)
CLAUDE_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-opus-4-6

# 네이버 블로그 (Selenium 자동 로그인/포스팅)
NAVER_ID=your_naver_id
NAVER_PASSWORD=your_naver_password
NAVER_BLOG_URL=https://blog.naver.com/your_blog_id
# Selenium이 헤드리스 크롬을 사용할 실행 파일 경로 (Docker 이미지엔 기본 포함)
CHROME_BIN=/usr/bin/chromium
SELENIUM_HEADLESS=true

# Google Blogger API
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=xxxxx
GOOGLE_BLOGGER_BLOG_ID=xxxxx

# 광고
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_SLOT_ID=xxxxxxxxxx

# 모든 신규 포스트 상단에 자동으로 삽입되는 기본 배너 (쿠팡 파트너스 등). 비워두면 자동 삽입 안 함.
DEFAULT_TOP_BANNER_HTML=<iframe src="https://coupa.ng/cpv5uY" width="100%" height="75" frameborder="0" scrolling="no" referrerpolicy="unsafe-url"></iframe>
