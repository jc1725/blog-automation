{
  "name": "blog-automation",
  "version": "1.0.0",
  "description": "키워드 기반 원고 생성부터 네이버 블로그/구글 Blogger 자동 발행, 광고 삽입까지 처리하는 블로그 자동화 백엔드",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "google:token": "ts-node scripts/getGoogleRefreshToken.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "selenium-webdriver": "^4.26.0",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1",
    "@types/selenium-webdriver": "^4.1.26",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
